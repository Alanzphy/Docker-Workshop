{
  "name": "Docker-Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "forwardPorts": [
    3000,
    8000,
    8081,
    5433
  ],
  "portsAttributes": {
    "3000": {
      "label": "Demo 1 - Grafana",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "1883": {
      "label": "Demo 1 - MQTT",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "Demo 2 - API FastAPI",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "8086": {
      "label": "Demo 1 - InfluxDB",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "8081": {
      "label": "Demo 2 - Mantenimiento",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5433": {
      "label": "Demo 2 - PostgreSQL",
      "onAutoForward": "silent",
      "requireLocalPort": false
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "redhat.vscode-yaml"
      ]
    }
  }
}
